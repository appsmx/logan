// LOGAN OS — Prisma schema
// LOGAN evolved from a methodology into a multi-role AI operating system.
// Core (orchestrator), Memory (context), specialist roles (Marketing, Dev, Design, ...).
// The differentiator: every specialist decision is recorded as a HIPÓTESIS that
// Analytics later verifies (verificada / refutada) — the learning loop.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A "project" in LOGAN OS = an empresa/aplicación being created, administered or grown
// by the LOGAN OS role ecosystem. Equivalent to a "Biblia del Proyecto" owner.
model Project {
  id          String   @id @default(cuid())
  name        String
  vision      String
  users       String   @default("[]") // JSON array of strings (audience descriptions)
  status      String   @default("En construcción") // En construcción | En revisión | Oficial
  currentPhase Int     @default(1) // 1..8 — Ciclo metodológico
  currentMode String  @default("exploracion") // exploracion | arquitectura | construccion | auditoria | evolucion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions       Decision[]
  backlogItems    BacklogItem[]
  sessionContexts SessionContext[]
  phaseProgress   PhaseProgress[]
  audits          Audit[]
  discoveries     Discovery[]
  hypotheses      Hypothesis[]
  memoryEntries   MemoryEntry[]
  marketingAssets MarketingAsset[]
  devAssets       DevAsset[]
  designAssets    DesignAsset[]
}

// LOGAN OS — the singleton Vision document (above the Constitution).
// One row, key = "vision".
model Vision {
  id        String   @id @default(cuid())
  key       String   @unique @default("vision")
  content   String   // markdown
  updatedAt DateTime @updatedAt
}

// A role-attributed important decision (DEC-XXX), per LOGAN §5.
model Decision {
  id            String   @id @default(cuid())
  projectId     String
  roleId        String   @default("core") // which role proposed this decision
  decId         String   // "DEC-001"
  title         String
  problem       String
  alternatives  String   // JSON array of strings (minimum 2)
  decision      String
  justification String
  consequences  String
  status        String   @default("aprobada") // aprobada | propuesta | descartada
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BacklogItem {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  status      String   @default("pendiente") // pendiente | en_progreso | completada
  priority    String   @default("media") // baja | media | alta
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// SESSION_CONTEXT — generated by the PCS (Protocolo de Continuidad de Sesión, §10).
model SessionContext {
  id                String   @id @default(cuid())
  projectId         String
  status            String
  advance           String
  objectiveCompleted String
  decisionsTaken    String   // JSON array
  documentsUpdated  String   // JSON array of {doc, change}
  pending           String
  risks             String
  nextObjective     String
  observations      String
  createdAt         DateTime @default(now())

  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model PhaseProgress {
  id          String   @id @default(cuid())
  projectId   String
  phase       Int      // 1..8
  status      String   @default("pendiente") // pendiente | en_progreso | completada
  notes       String
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
}

model Audit {
  id              String   @id @default(cuid())
  projectId       String
  deliverableName String
  checks          String   // JSON object of the 7 checklist items -> boolean
  passed          Boolean  @default(false)
  notes           String
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Discovery {
  id            String   @id @default(cuid())
  projectId     String
  type          String   // contexto | restriccion | decision | validacion | riesgo
  question      String
  answer        String
  classification String  // universal | especifico | temporal
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// THE DIFFERENTIATOR — every specialist decision is a hypothesis that can be verified.
// roleId = which role proposed it (e.g. "marketing", "dev", "design", "core").
// status: pendiente | en_observacion | verificada | refutada
model Hypothesis {
  id         String   @id @default(cuid())
  projectId  String
  roleId     String
  context    String   // what situation triggered this hypothesis
  hypothesis String  // "we believe X will happen because Y"
  prediction String  // the measurable/observable outcome we expect
  status     String   @default("pendiente")
  outcome    String   // what actually happened (filled at verification)
  evidence   String   // evidence / data supporting the outcome
  createdAt  DateTime @default(now())
  verifiedAt DateTime?

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// LOGAN Memory — context summaries and change detection (reads the shared repo / sources).
model MemoryEntry {
  id              String   @id @default(cuid())
  projectId       String
  source          String   // e.g. "GitHub: appsmx/logan"
  summary         String
  changesDetected String
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Marketing role deliverables — each linked to a Hypothesis (the differentiator).
// type: campaign_brief | ad_copy | image_prompt | video_prompt | budget | competitor_analysis | page_analysis | improvement_proposal
model MarketingAsset {
  id           String   @id @default(cuid())
  projectId    String
  type         String
  title        String
  content      String   // markdown / structured content
  hypothesisId String?  // optional link to the Hypothesis it tests
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Dev role deliverables — each linked to a Hypothesis (the differentiator).
// type: architecture_doc | code_implementation | code_refactor | test_suite |
//       code_review | bug_fix | db_schema | project_scaffold | technical_doc |
//       performance_report | security_report
model DevAsset {
  id           String   @id @default(cuid())
  projectId    String
  type         String
  title        String
  content      String   // markdown / code content
  hypothesisId String?  // optional link to the Hypothesis it tests
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Design role deliverables — each linked to a Hypothesis (the differentiator).
// type: ui_spec | design_system | interaction_flow | visual_asset |
//       usability_review | design_handoff | design_audit | image_asset_prompt
model DesignAsset {
  id           String   @id @default(cuid())
  projectId    String
  type         String
  title        String
  content      String   // markdown / specification content
  hypothesisId String?  // optional link to the Hypothesis it tests
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
